    given-names: Yao
    alias: cadamcat
repository-code: "https://github.com/cadamcat/equal-divisor-sums-lean4"
url: "https://github.com/cadamcat/equal-divisor-sums-lean4"
license: Apache-2.0
version: 1.0.0
keywords:
  - Lean 4
  - formalization
  - sum of divisors
  - smooth shifted primes
  - Erdős problems
